**EXERCICIO 2**


library IEEE;
use IEEE.std_logic_1164.all;

entity somador_completo is
    port (
        A, B, Te : in bit;
        S, Ts : out bit
    );
end somador_completo;

architecture arquitetura of somador_completo is
begin

    S <= A xor B xor Te;

    Ts <= (A and B) or (A and Te) or (B and Te);

end arquitetura;

