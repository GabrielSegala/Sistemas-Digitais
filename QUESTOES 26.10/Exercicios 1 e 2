EXERCICIO 1

A) 

library IEEE;
use IEEE.std_logic_1164.all;

entity exercicio_1a is
    port (
        A, B, C, D : in bit;
        W : out bit
    );
end exercicio_1a;

architecture arquitetura of exercicio_1a is
begin

    W <= (A or B) and (C or D);

end arquitetura;

